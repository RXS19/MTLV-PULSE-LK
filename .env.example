# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL connection string for Vercel Serverless (user: pulse_readonly)
DATABASE_URL="postgres://pulse_readonly:PASSWORD@HOST:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://pulse_readonly:PASSWORD@HOST:5432/postgres?sslmode=require"
