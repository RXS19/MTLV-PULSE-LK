# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL connection settings for PULSE Read-Only User
PULSE_DB_HOST="aws-0-us-east-1.pooler.supabase.com"
PULSE_DB_PORT="5432"
PULSE_DB_NAME="postgres"
PULSE_DB_USER="pulse_readonly"
PULSE_DB_PASSWORD=""
PULSE_DB_SSL="true"
PULSE_DATABASE_URL=""
DATABASE_URL=""
POSTGRES_URL=""
